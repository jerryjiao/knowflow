---
/**
 * Shared landing page for KnowFlow — one component, two locales.
 * Audience: general knowledge-management users (Obsidian/Notion crowd).
 * Voice: outcome-first, plain language, no jargon above the fold.
 * Design rules: light background, one solid blue (#2563eb), flat, no gradients.
 */
import '../styles/landing.css';

interface Props {
  lang: 'en' | 'zh';
}

const { lang } = Astro.props;
const zh = lang === 'zh';
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const home = zh ? `${base}zh/` : base;
const otherHome = zh ? base : `${base}zh/`;
const otherLangTarget = zh ? 'en' : 'zh';
const docsHome = `${base}${lang}/intro/`;
const quickstartUrl = `${base}${lang}/quickstart/`;
const githubUrl = 'https://github.com/jerryjiao/knowflow';

const t = zh
  ? {
      title: 'KnowFlow — 别再囤链接了，把收藏变成知识',
      description:
        '把你收藏的文章和笔记变成互联的知识页面。AI 助手负责整理，每一页都是你自己的纯 Markdown 文件。开源、本地运行。',
      eyebrow: '开源 · 本地运行 · 数据归你',
      h1: '别再囤链接了，把收藏变成知识',
      sub: 'KnowFlow 把你收藏的文章和笔记变成互联的知识页面——AI 助手负责整理，每一页都是你自己的纯 Markdown 文件。',
      ctaPrimary: '看看它长什么样',
      ctaSecondary: 'GitHub',
      installNote: '一行命令安装（也可以让 AI 助手帮你跑）· npm 包即将上线，当前从源码安装',
      visBody: '一个概念页，链回支持它的来源——每一页都是这样的纯 Markdown。',
      painQ: '收藏夹里躺着多少篇「改天再读」？',
      painA: '存了 ≠ 学了。收藏只解决「存」，从不解决「记得」和「连得上」。',
      demoKicker: '实拍',
      demoTitle: '你的收藏，长成一张知识地图',
      demoSub: '每一页是一个 Markdown 文件，页面之间的链接自动织成这张图——放大、拖拽、顺着关系走。',
      demoCta: '三步跑出你的第一张图 →',
      whatKicker: 'KnowFlow 是什么',
      whatTitle: '三个承诺',
      pillars: [
        { icon: '📁', title: '每一页都归你', body: '知识库就是文件夹里的纯 Markdown。随时打包带走，永不被产品绑架。' },
        { icon: '🤝', title: 'AI 助手替你整理', body: 'Claude、Cursor 或任何你信任的 AI：读取你的原始收藏，起草互联页面，你只需审一眼。' },
        { icon: '🕸️', title: '看见知识与知识的联系', body: '互联的页面自动织成图谱，让你看见没有搜过的关联。' },
      ],
      howKicker: '怎么运转',
      howTitle: '存、理、看',
      howSub: '三步，全程透明，没有黑盒。',
      steps: [
        { title: '存', body: '文章、推文、笔记原样保存进 raw/，一个字不改。', code: 'raw/' },
        { title: '理', body: 'AI 助手按模板起草实体页、概念页、对比页，互相链接，等你审核。', code: 'wiki/' },
        { title: '看', body: '一键生成图谱、检查断链、按标签聚合。', code: 'graph.html' },
      ],
      techNote: '给技术朋友：全程只有三条命令',
      boundaryKicker: '放心之处',
      boundaryTitle: 'AI 只做整理，不做主',
      bdBody: [
        'AI 起草每一页，但它动不了你的原始收藏——存下来的东西永远原样。',
        '每一步都是看得见的 Markdown 改动，不满意随时改回来，换一个 AI 助手也照常运转。',
      ],
      bdQuote: '灵感来自 Andrej Karpathy 的 LLM Wiki：整理成互联页面的知识，才比一堆收藏更有价值。',
      ftKicker: '还有这些',
      ftTitle: '顺手的细节',
      features: [
        { icon: '📁', title: '纯文件，无锁定', body: '全部内容是本地 Markdown，用 Obsidian 直接打开也行。' },
        { icon: '🤖', title: '任意 AI 助手', body: '只要是能读写文件的 AI 助手都能用，随时换。' },
        { icon: '🕸️', title: '知识图谱', body: '交互式图谱 + 原始图数据，可导出到任何工具。' },
        { icon: '🏥', title: '健康检查', body: '断链、空页、孤儿页自动发现，一条命令修复。' },
        { icon: '🏷️', title: '标签聚合页', body: '给页面打 [[标签]]，自动生成话题索引页。' },
        { icon: '🔎', title: '语义搜索（可选）', body: '想问「类似 XX 的内容」时才需要，默认不开。' },
      ],
      ctaTitle: '从下一篇「改天再读」开始',
      ctaSub: '三步，跑出你的第一张知识图谱。',
      ctaBtn: '开始 →',
      footerNote: 'npm 包即将发布，当前从源码安装。',
      docs: '文档',
      docsHome: '简介',
      langSwitch: 'English',
      demoAlt: 'KnowFlow 知识图谱实拍',
    }
  : {
      title: 'KnowFlow — Stop saving. Start knowing.',
      description:
        'Turn the articles and notes you save into linked knowledge pages. Your AI assistant does the organizing; every page is plain Markdown you own. Open source, runs locally.',
      eyebrow: 'Open source · Runs locally · Your data stays yours',
      h1: 'Stop saving. Start knowing.',
      sub: 'KnowFlow turns the articles and notes you save into linked knowledge pages — your AI assistant does the organizing, and every page is plain Markdown you own.',
      ctaPrimary: 'See what it looks like',
      ctaSecondary: 'GitHub',
      installNote: 'One-line install (or let your AI assistant run it for you) · npm package coming soon — install from source today',
      visBody: 'One concept page, linked back to the source that supports it. Every page is plain Markdown, just like this.',
      painQ: 'How many “read later” links are sitting in your bookmarks right now?',
      painA: 'Saving isn’t learning. Bookmarks solve storing — never remembering, never connecting.',
      demoKicker: 'Real screenshot',
      demoTitle: 'Your saves, grown into a map of what you know',
      demoSub: 'Every page is a Markdown file; the links between them weave this graph automatically — zoom, drag, follow connections.',
      demoCta: 'Build your first graph in three steps →',
      whatKicker: 'What is KnowFlow',
      whatTitle: 'Three promises',
      pillars: [
        { icon: '📁', title: 'Every page is yours', body: 'Your knowledge base is plain Markdown in folders. Pack it up anytime — no lock-in, ever.' },
        { icon: '🤝', title: 'An AI assistant does the organizing', body: 'Claude, Cursor, or any assistant you trust reads your raw saves, drafts linked pages, and waits for your review.' },
        { icon: '🕸️', title: 'See how knowledge connects', body: 'Linked pages weave themselves into a graph, surfacing connections you never searched for.' },
      ],
      howKicker: 'How it works',
      howTitle: 'Save, organize, see',
      howSub: 'Three steps, fully transparent, no black box.',
      steps: [
        { title: 'Save', body: 'Articles, tweets, and notes land in raw/ exactly as captured.', code: 'raw/' },
        { title: 'Organize', body: 'Your AI assistant drafts entity, concept, and comparison pages from templates — you review.', code: 'wiki/' },
        { title: 'See', body: 'One command builds the graph, checks links, and groups by tag.', code: 'graph.html' },
      ],
      techNote: 'For the technically curious: the whole loop is three commands',
      boundaryKicker: 'Peace of mind',
      boundaryTitle: 'The AI organizes. It never decides.',
      bdBody: [
        'The assistant drafts every page, but it cannot touch your original saves — what you captured stays exactly as captured.',
        'Every change is a visible Markdown edit you can revert, and swapping to a different assistant changes nothing.',
      ],
      bdQuote: 'Inspired by Andrej Karpathy’s LLM Wiki: knowledge curated into connected pages beats a pile of saved links.',
      ftKicker: 'Also included',
      ftTitle: 'Thoughtful details',
      features: [
        { icon: '📁', title: 'Plain files, no lock-in', body: 'Everything is local Markdown — you can open it in Obsidian directly.' },
        { icon: '🤖', title: 'Any AI assistant', body: 'If it can read and write files, it can run your wiki. Swap anytime.' },
        { icon: '🕸️', title: 'Knowledge graph', body: 'Interactive viewer plus raw graph data you can export anywhere.' },
        { icon: '🏥', title: 'Health checks', body: 'Broken links, empty pages, and orphans are caught — one command fixes them.' },
        { icon: '🏷️', title: 'Tag hubs', body: 'Tag pages with [[tags]] and topic index pages build themselves.' },
        { icon: '🔎', title: 'Semantic search (optional)', body: 'Only when you want “find things like this” — off by default.' },
      ],
      ctaTitle: 'Start with your next “read later”',
      ctaSub: 'Three steps to your first knowledge graph.',
      ctaBtn: 'Get started →',
      footerNote: 'npm package coming soon — install from source today.',
      docs: 'Docs',
      docsHome: 'Introduction',
      langSwitch: '中文',
      demoAlt: 'KnowFlow knowledge graph screenshot',
    };
---

<!doctype html>
<html lang={zh ? 'zh-CN' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.title}</title>
    <meta name="description" content={t.description} />
    <meta property="og:title" content={t.title} />
    <meta property="og:description" content={t.description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="https://jerryjiao.github.io/knowflow/social-preview.png" />
    <meta property="og:url" content={`https://jerryjiao.github.io${home}`} />
    <link rel="icon" type="image/png" href={`${base}favicon.png`} />
    {
      !zh && (
        <script is:inline define:vars={{ otherHome }}>
          (function () {
            try {
              var pref = localStorage.getItem('kf-lang');
              if (pref === 'zh') {
                location.replace(otherHome);
                return;
              }
              if (!pref) {
                var nav = (navigator.languages && navigator.languages[0]) || navigator.language || 'en';
                if (String(nav).toLowerCase().indexOf('zh') === 0) {
                  localStorage.setItem('kf-lang', 'zh');
                  location.replace(otherHome);
                }
              }
            } catch (e) {
              /* no localStorage / no JS: stay on the English page */
            }
          })();
        </script>
      )
    }
  </head>
  <body>
    <header class="site-header">
      <div class="container">
        <a class="wordmark" href={home}>
          <img class="wordmark-logo" src={`${base}logo.png`} alt="KnowFlow" width="26" height="26" />
          <span>Know<span class="flow">Flow</span></span>
        </a>
        <nav class="site-nav">
          <a href={docsHome}>{t.docs}</a>
          <a class="nav-github" href={githubUrl} rel="noopener">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
              <path
                d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
              ></path>
            </svg>
            <span class="nav-github-label">GitHub</span>
          </a>
          <a class="lang-switch" href={otherHome} data-lang={otherLangTarget} aria-label={t.langSwitch}>{t.langSwitch}</a>
        </nav>
      </div>
    </header>

    <main>
      <section class="hero">
        <div class="container">
          <div class="hero-grid">
            <div class="hero-copy">
              <span class="hero-eyebrow">{t.eyebrow}</span>
              <h1>{t.h1}</h1>
              <p class="hero-sub">{t.sub}</p>
              <div class="hero-ctas">
                <a class="btn btn-primary" href="#demo">{t.ctaPrimary} ↓</a>
                <a class="btn btn-outline" href={githubUrl} rel="noopener">{t.ctaSecondary} ↗</a>
              </div>
              <div class="hero-install">
                <code class="hero-install-cmd">npx knowflow@latest init my-wiki</code>
                <span class="hero-install-note">{t.installNote}</span>
              </div>
            </div>
            <div class="hero-visual" aria-hidden="true">
              <div class="window window--back">
                <div class="window-bar">
                  <span class="terminal-dot"></span>
                  <span class="terminal-dot"></span>
                  <span class="terminal-dot"></span>
                  <span class="window-title">wiki/sources/capture-example.md</span>
                </div>
                <div class="window-body">
                  <span class="win-ghost" style="width: 62%"></span>
                  <span class="win-ghost" style="width: 88%"></span>
                  <span class="win-ghost" style="width: 44%"></span>
                </div>
              </div>
              <div class="window window--front">
                <div class="window-bar">
                  <span class="terminal-dot"></span>
                  <span class="terminal-dot"></span>
                  <span class="terminal-dot"></span>
                  <span class="window-title">wiki/concepts/linked-knowledge.md</span>
                </div>
                <div class="window-body">
                  <p class="win-h"># Linked knowledge</p>
                  <p class="win-p">{t.visBody}</p>
                  <p class="win-h2">## Connections</p>
                  <p class="win-links">
                    <span>[[index]]</span>
                    <span>[[concepts/knowledge-graph]]</span>
                    <span>[[sources/capture-example]]</span>
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="pain-strip">
        <div class="container">
          <p class="pain-q">{t.painQ}</p>
          <p class="pain-a">{t.painA}</p>
        </div>
      </section>

      <section class="section" id="demo">
        <div class="container">
          <div class="section-head">
            <p class="section-kicker">{t.demoKicker}</p>
            <h2>{t.demoTitle}</h2>
            <p class="section-sub">{t.demoSub}</p>
          </div>
          <a class="showcase" href={quickstartUrl}>
            <img src={`${base}graph-demo.png`} alt={t.demoAlt} width="1440" height="900" loading="lazy" />
          </a>
          <p class="showcase-cta"><a href={quickstartUrl}>{t.demoCta}</a></p>
        </div>
      </section>

      <section class="section section-alt">
        <div class="container">
          <div class="section-head">
            <p class="section-kicker">{t.whatKicker}</p>
            <h2>{t.whatTitle}</h2>
          </div>
          <div class="pillars">
            {t.pillars.map((p) => (
              <div class="pillar">
                <span class="feature-icon">{p.icon}</span>
                <h3>{p.title}</h3>
                <p>{p.body}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      <section class="section">
        <div class="container">
          <div class="section-head">
            <p class="section-kicker">{t.howKicker}</p>
            <h2>{t.howTitle}</h2>
            <p class="section-sub">{t.howSub}</p>
          </div>
          <div class="pipeline">
            {t.steps.map((step, i) => (
              <div class="pipeline-step">
                <span class="step-no">{i + 1}</span>
                <h3>{step.title}</h3>
                <p>{step.body}</p>
                <span class="step-code">{step.code}</span>
                {i < 2 && <span class="pipeline-arrow" aria-hidden="true">→</span>}
              </div>
            ))}
          </div>
          <div class="terminal terminal--sm">
            <div class="terminal-bar">
              <span class="terminal-dot"></span>
              <span class="terminal-dot"></span>
              <span class="terminal-dot"></span>
              <span class="terminal-title">{t.techNote}</span>
            </div>
            <div class="terminal-body">
              <div><span class="prompt">$</span><span class="cmd">knowflow init my-wiki</span></div>
              <div><span class="prompt">$</span><span class="cmd">knowflow ingest <span class="flag">{zh ? '“那篇收藏了很久的文章”' : '“that article you saved months ago”'}</span> --source text</span></div>
              <div><span class="prompt">$</span><span class="cmd">knowflow graph <span class="flag">--no-open</span></span> <span class="ok">✓ graph/graph.html</span></div>
            </div>
          </div>
        </div>
      </section>

      <section class="section section-alt">
        <div class="container">
          <div class="section-head">
            <p class="section-kicker">{t.boundaryKicker}</p>
            <h2>{t.boundaryTitle}</h2>
          </div>
          <div class="boundary">
            {t.bdBody.map((line) => <p>{line}</p>)}
            <p class="boundary-quote">{t.bdQuote}</p>
          </div>
        </div>
      </section>

      <section class="section">
        <div class="container">
          <div class="section-head">
            <p class="section-kicker">{t.ftKicker}</p>
            <h2>{t.ftTitle}</h2>
          </div>
          <div class="features">
            {t.features.map((f) => (
              <div class="feature">
                <span class="feature-icon">{f.icon}</span>
                <h3>{f.title}</h3>
                <p>{f.body}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      <section class="cta-band">
        <div class="container">
          <h2>{t.ctaTitle}</h2>
          <p>{t.ctaSub}</p>
          <div class="cta-band-actions">
            <a class="btn btn-invert" href={quickstartUrl}>{t.ctaBtn}</a>
            <code class="cta-band-cmd">npx knowflow@latest init my-wiki</code>
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="container">
        <span>KnowFlow · MIT © Jerry Jiao · {t.footerNote}</span>
        <span class="footer-links">
          <a href={githubUrl} rel="noopener">GitHub</a>
          <a href={docsHome}>{t.docsHome}</a>
          <a href={quickstartUrl}>Quickstart</a>
          <a href={otherHome} data-lang={otherLangTarget}>{t.langSwitch}</a>
        </span>
      </div>
    </footer>

    <script>
      document.querySelectorAll('a[data-lang]').forEach((a) => {
        a.addEventListener('click', () => {
          try {
            localStorage.setItem('kf-lang', (a as HTMLElement).dataset.lang ?? '');
          } catch {
            /* localStorage unavailable: language switch still navigates */
          }
        });
      });
    </script>
  </body>
</html>
